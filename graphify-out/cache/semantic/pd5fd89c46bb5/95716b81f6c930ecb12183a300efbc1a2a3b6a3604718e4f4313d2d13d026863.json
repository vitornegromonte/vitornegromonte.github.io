{"nodes": [{"id": "src_content_notes_generative_images", "label": "Generative Models for Images", "file_type": "document", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_style_transfer", "label": "Style Transfer", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a pretrained CNN as a hierarchical feature extractor: deep layers encode content (objects/forms), shallow-to-mid layers encode style (textures/color/patterns), so one network can separate the two signals."}, {"id": "src_content_notes_generative_images_neural_algorithm_of_artistic_style", "label": "A Neural Algorithm of Artistic Style (Gatys et al.)", "file_type": "paper", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Leon Gatys et al.", "contributor": null}, {"id": "src_content_notes_generative_images_content_loss", "label": "Content Loss", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_style_loss", "label": "Style Loss", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_gram_matrix", "label": "Gram Matrix", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inner products between vectorized feature maps capture co-occurrence of features, i.e. texture, while being invariant to spatial arrangement, which is what makes style separable from content."}, {"id": "src_content_notes_generative_images_autoencoder", "label": "Autoencoder", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_latent_space", "label": "Latent Space", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_vae", "label": "Variational Autoencoder (VAE)", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models a probability distribution over the latent space instead of a deterministic code, which is what enables sampling and generation and makes the latent space smooth enough to interpolate."}, {"id": "src_content_notes_generative_images_reparameterization_trick", "label": "Reparameterization Trick", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sampling z from q(z|x) is stochastic and non-differentiable; sampling epsilon from a fixed base distribution and transforming it keeps the graph differentiable so gradient descent still works."}, {"id": "src_content_notes_generative_images_elbo", "label": "ELBO (Evidence Lower Bound)", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_kl_divergence", "label": "Kullback-Leibler Divergence", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_gan", "label": "Generative Adversarial Network (GAN)", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two models compete in a zero-sum game so the generator never needs an explicit likelihood; the trade-off is instability and mode collapse, which motivated the alternative losses listed for WGAN/LSGAN."}, {"id": "src_content_notes_generative_images_goodfellow_2014", "label": "Generative Adversarial Networks (Goodfellow et al., 2014)", "file_type": "paper", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Ian Goodfellow et al.", "contributor": null}, {"id": "src_content_notes_generative_images_minimax_game", "label": "Minimax Game", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_nash_equilibrium", "label": "Nash Equilibrium", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_jensen_shannon_divergence", "label": "Jensen-Shannon Divergence", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_non_saturating_heuristic", "label": "Non-Saturating Heuristic", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reformulating the generator loss avoids weak gradients when the discriminator easily rejects samples; the cost is that it no longer has the same theoretical basis as minimizing the Jensen-Shannon divergence."}, {"id": "src_content_notes_generative_images_wgan", "label": "Wasserstein GAN (WGAN)", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_lsgan", "label": "Least Squares GAN (LSGAN)", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_diffusion_models", "label": "Diffusion Models", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits generation into a fixed forward noising process and a learned reverse denoising chain, trading much higher sampling cost for training stability and better sample quality than GANs or VAEs."}, {"id": "src_content_notes_generative_images_ddpm", "label": "DDPM (Denoising Diffusion Probabilistic Models)", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generative_images_unet", "label": "U-Net", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip connections between the contracting and expanding paths preserve fine details while still capturing multi-scale context, which is why it predicts the noise well at every diffusion step."}, {"id": "src_content_notes_generative_images_stable_diffusion", "label": "Stable Diffusion", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running diffusion in a pretrained VAE latent space instead of pixel space cuts compute and sampling time and lets the diffusion model focus on high-level semantics while the VAE handles low-level detail."}, {"id": "src_content_notes_generative_images_cross_attention", "label": "Cross-Attention Conditioning", "file_type": "concept", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generative_images_figures_fig0", "label": "Figure 0 (Generative Models for Images)", "file_type": "image", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generative_images_figures_fig1", "label": "Figure 1 (Generative Models for Images)", "file_type": "image", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generative_images_figures_fig2", "label": "Figure 2 (Generative Models for Images)", "file_type": "image", "source_file": "src/content/notes/generative-images.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generative_images_figures_fig3", "label": "Figure 3 (Generative Models for Images)", "file_type": "image", "source_file": "