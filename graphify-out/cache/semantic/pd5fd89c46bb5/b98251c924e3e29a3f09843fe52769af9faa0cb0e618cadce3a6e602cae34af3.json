{"nodes": [{"id": "src_content_notes_autodiff", "label": "Differentiable Programming and Optimization", "file_type": "document", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_chain_rule", "label": "Chain Rule", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_sum_rule", "label": "Multivariable Chain Rule (Sum Rule)", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A parameter that reaches the loss along multiple paths must receive the gradient contribution of every path; this is why autograd accumulates with += instead of assignment. Overwriting would drop gradient paths and yield incorrect updates."}, {"id": "src_content_notes_autodiff_computational_graph", "label": "Computational Graph (DAG)", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expressions are represented as a DAG of operations so the chain rule can be applied automatically instead of by hand: forward pass evaluates leaves to root and caches values, backward pass walks the same graph in reverse."}, {"id": "src_content_notes_autodiff_backpropagation", "label": "Backpropagation", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_forward_mode_autodiff", "label": "Forward-Mode Autodiff (Dual Numbers)", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attaching a dual number x + x_dot*eps propagates one directional derivative per pass, so a full gradient over n parameters costs n forward passes \u2014 hopeless for networks with millions of parameters."}, {"id": "src_content_notes_autodiff_reverse_mode_autodiff", "label": "Reverse-Mode Autodiff", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for deep learning because the network has millions of inputs (parameters) and a single scalar output: one forward plus one backward pass yields the derivative with respect to every input at O(graph size) cost."}, {"id": "src_content_notes_autodiff_valor", "label": "Valor autograd class", "file_type": "code", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores data plus grad and builds the computational graph dynamically via operator overloading; each op defines a local _backward closure, so any differentiable function composes from a small set of primitives."}, {"id": "src_content_notes_autodiff_backward", "label": "Valor.backward (topological backward pass)", "file_type": "code", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_topological_sort", "label": "Topological Sort", "file_type": "rationale", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A node is processed only after all its children, so by iterating in reverse topological order the incoming gradient (out.grad) is fully accumulated before local gradients are computed."}, {"id": "src_content_notes_autodiff_neuron", "label": "Neuron class (Valor-based)", "file_type": "code", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_layer", "label": "Layer class (Valor-based)", "file_type": "code", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_mlp", "label": "MLP class (Valor-based)", "file_type": "code", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The network is built the same way as any expression, so calling the model performs the forward pass and silently constructs the graph; parameters() collects exactly the leaves whose gradients backpropagation will fill."}, {"id": "src_content_notes_autodiff_jacobian", "label": "Jacobian", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_vjp", "label": "Vector-Jacobian Product (VJP)", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Materializing full Jacobians is infeasible, so autograd only needs each op to multiply an incoming gradient vector by its Jacobian; for elementwise ops the Jacobian is diagonal and the VJP is an elementwise product."}, {"id": "src_content_notes_autodiff_loss_landscape", "label": "Loss Landscape", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_training_loop", "label": "Training Loop", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gradients must be zeroed before each backward pass because they accumulate by design (sum rule); otherwise gradients from previous steps pile up and updates overshoot."}, {"id": "src_content_notes_autodiff_mini_batch_sgd", "label": "Mini-Batch SGD", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balances the low-variance estimate of batch gradient descent with the GPU throughput of batched matrix multiplications; batch size controls the gradient noise level."}, {"id": "src_content_notes_autodiff_learning_rate", "label": "Learning Rate", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Too large overshoots the valley and diverges (each step lands higher on the opposite slope); too small wastes compute \u2014 hence schedules or adaptive per-parameter rates."}, {"id": "src_content_notes_autodiff_momentum", "label": "Momentum Optimizer", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accumulating velocity makes perpendicular (zig-zag) components cancel while the down-ravine component grows, fixing plain SGD's oscillation in ravines; gamma ~0.9 is a robust default."}, {"id": "src_content_notes_autodiff_rmsprop", "label": "RMSProp Optimizer", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Divides the step by a moving average of squared gradients, shrinking the effective rate of parameters with consistently large gradients and normalizing step sizes across the network; eps prevents division by zero."}, {"id": "src_content_notes_autodiff_adam", "label": "Adam (Adaptive Moment Estimation)", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines momentum (first moment) and RMSProp (second moment) with bias correction; the correction is needed because m_t and v_t start at zero and would otherwise make early updates far too small, slowing the start of training."}, {"id": "src_content_notes_autodiff_xor", "label": "XOR Training Example (MLP 2-4-1)", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_pytorch", "label": "PyTorch Autograd", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_autodiff_figures_fig_24552d20bc", "label": "A computational graph for L = (a x b) + c", "file_type": "image", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_autodiff_figures_fig_720cf61e78", "label": "A slice of a loss landscape", "file_type": "image", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_autodiff_figures_fig_ce73b714fe", "label": "Effect of the learning rate on training", "file_type": "image", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_autodiff_figures_fig_be28103d51", "label": "Optimization in a ravine: plain SGD vs Momentum", "file_type": "image", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff", "label": "Automatic Differentiation (note)", "file_type": "document", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_computational_graph", "label": "Computational graph", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_loss_landscape", "label": "Loss landscape", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_learning_rate", "label": "Learning rate", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_autodiff_momentum", "label": "Momentum", "file_type": "concept", "source_file": "src/content/notes/autodiff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_content_notes_autodiff_chain_rule", "target": "src_content_notes_autodiff_sum_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/notes/autodiff.md", "source_location": null, "weight": 1.0}, {"source": "src_cont