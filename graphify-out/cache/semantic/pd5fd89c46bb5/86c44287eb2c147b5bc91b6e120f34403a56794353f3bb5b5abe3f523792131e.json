{"nodes": [{"id": "src_content_notes_generalization", "label": "Generalization and Regularization", "file_type": "document", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generalization_generalization", "label": "Generalization", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generalization_empirical_risk", "label": "Empirical Risk vs Expected Risk", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The true distribution is unavailable, so we minimize the error over the training dataset as a proxy for the expected risk over all data."}, {"id": "src_content_notes_generalization_bias_variance_decomposition", "label": "Bias-Variance Decomposition", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits expected squared error into Bias^2 (wrong assumptions, underfitting), Variance (sensitivity to training-set fluctuations, overfitting) and irreducible noise; classical practice sought the capacity minimizing their sum."}, {"id": "src_content_notes_generalization_double_descent", "label": "Double Descent", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past the interpolation threshold, hugely over-parameterized models see test error drop again: they seek the simplest function interpolating the data, which is why billion-parameter LLMs do not catastrophically overfit."}, {"id": "src_content_notes_generalization_regularization", "label": "Regularization", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any technique that reduces generalization error, usually at the cost of increased training error, by constraining the hypothesis space."}, {"id": "src_content_notes_generalization_l2_regularization", "label": "L2 Regularization (Weight Decay)", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equivalent to MAP estimation with a Gaussian prior over weights; the penalty adds lambda*w to the gradient so weights decay by (1 - eta*lambda) each step, preferring distributed small weights over a few dominant ones."}, {"id": "src_content_notes_generalization_dropout", "label": "Dropout class", "file_type": "code", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents co-adaptation by forcing redundant representations; the mask is scaled by 1/(1-p) at training time (inverted dropout) so inference needs no scaling and keeps the expected output magnitude."}, {"id": "src_content_notes_generalization_batch_normalization", "label": "BatchNorm class", "file_type": "code", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learnable gamma/beta let the layer recover the identity if normalization would destroy useful signal; an EMA of batch statistics is kept because a single batch's statistics at inference are unreliable (hence model.eval())."}, {"id": "src_content_notes_generalization_early_stopping", "label": "Early Stopping", "file_type": "rationale", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Halting when validation loss starts to rise constrains the optimizer's trajectory in weight space, landing in a wider, flatter minimum that generalizes better than a sharp deep one."}, {"id": "src_content_notes_generalization_internal_covariate_shift", "label": "Internal Covariate Shift", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generalization_co_adaptation", "label": "Co-adaptation", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generalization_figures_fig_f54c509ee9", "label": "The classical Bias-Variance Tradeoff", "file_type": "image", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generalization_figures_fig_569c04d695", "label": "Polynomial fits to the same noisy data", "file_type": "image", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generalization_figures_fig_0f15a2a08d", "label": "The Double Descent phenomenon", "file_type": "image", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generalization_figures_fig_26a77223ac", "label": "Dropout during training", "file_type": "image", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generalization_figures_fig_bb87f95058", "label": "The BatchNorm pipeline", "file_type": "image", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_generalization_figures_fig_68fdaa3cb6", "label": "Training vs. validation loss (early stopping)", "file_type": "image", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_generalization", "label": "Generalization and Regularization", "file_type": "concept", "source_file": "src/content/notes/generalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_content_notes_generalization", "target": "src_content_notes_autodiff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/notes/generalization.md", "source_location": null, "weight": 1.0}, {"source": "src_content_notes_generalization", "target": "src_content_notes_intro_neural_networks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/notes/generalization.md", "source_location": null, "weight": 1.0}, {"source": "src_content_notes_generalization", "target": "src_content_notes_generalization_generalization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/notes/generalization.md", "source_location": null, "weight": 1.0}, {"source": "src_content_notes_generalization_generalization", "target": "src_content_notes_generalization_empirical_risk", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.