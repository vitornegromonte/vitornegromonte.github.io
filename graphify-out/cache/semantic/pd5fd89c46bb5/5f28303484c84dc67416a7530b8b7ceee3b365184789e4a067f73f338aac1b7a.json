{"nodes": [{"id": "src_content_notes_world_models", "label": "World Models", "file_type": "document", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as a survey of internal representations across cognitive science, robotics, control theory and deep learning, not as a single architecture."}, {"id": "src_content_notes_world_models_mental_models", "label": "Mental Models in Psychology", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_craik_1943", "label": "The Nature of Explanation (Craik, 1943)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Kenneth Craik", "contributor": null}, {"id": "src_content_notes_world_models_dorsal_ventral_streams", "label": "Dorsal and Ventral Streams", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the biological precedent for separating representational ('what') from spatial ('where/how') pathways in modern world model architectures."}, {"id": "src_content_notes_world_models_free_energy_principle", "label": "Free Energy Principle (FEP)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes world models a thermodynamic necessity: minimizing variational free energy is an upper bound on sensory surprise, so perception becomes variational inference over a generative model."}, {"id": "src_content_notes_world_models_friston_fep", "label": "The free-energy principle: a unified brain theory? (Friston)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Karl Friston", "contributor": null}, {"id": "src_content_notes_world_models_active_inference", "label": "Active Inference", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treated as a direct corollary of the FEP: action and perception differ only in direction, and Expected Free Energy splits into epistemic (ambiguity reduction) and instrumental (risk minimization) terms, unifying exploration and exploitation."}, {"id": "src_content_notes_world_models_predictive_coding", "label": "Predictive Coding", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only residual prediction errors are propagated upward instead of raw sensory states, which is what maps onto self-supervised learning signals in RSSMs and Predictive Coding Networks."}, {"id": "src_content_notes_world_models_rao_ballard_1999", "label": "Predictive coding in the visual cortex (Rao and Ballard, 1999)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Rao and Ballard", "contributor": null}, {"id": "src_content_notes_world_models_predictive_world_models", "label": "Predictive World Models", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learn a transition dynamics function for forecasting; the weakness is susceptibility to representation collapse, the strength is cheap latent look-ahead planning."}, {"id": "src_content_notes_world_models_generative_world_models", "label": "Generative World Models", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model the full joint distribution so novel trajectories can be sampled; the gain is environment simulation, the cost is high computational sample cost."}, {"id": "src_content_notes_world_models_jepa", "label": "JEPA (Joint Embedding Predictive Architecture)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Yann LeCun", "contributor": null, "rationale": "Predicts in latent embedding space rather than pixels, deliberately rejecting generative reconstruction loops to avoid representational hallucinations; a stop-gradient on the target encoder prevents the trivial constant solution."}, {"id": "src_content_notes_world_models_lecun_ami", "label": "A Path Towards Autonomous Machine Intelligence (LeCun)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Yann LeCun", "contributor": null}, {"id": "src_content_notes_world_models_dreamer", "label": "Dreamer", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hafner et al.", "contributor": null, "rationale": "Trains all three components end-to-end with gradients through the dynamics and learns value/policy networks purely on imagined latent trajectories, avoiding pixel-level simulation."}, {"id": "src_content_notes_world_models_rssm", "label": "RSSM (Recurrent State-Space Model)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hybrid state: the deterministic path carries long-range temporal dependencies while the stochastic path captures multimodal outcomes, which avoids the posterior collapse of purely stochastic recurrent models."}, {"id": "src_content_notes_world_models_hafner_dreamer", "label": "Dream to Control: Learning Behaviors by Latent Imagination (Hafner et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hafner et al.", "contributor": null}, {"id": "src_content_notes_world_models_dreamerv2", "label": "DreamerV2", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discrete categorical latents with straight-through gradients give richer multimodal representations; KL balancing and two-hot reward prediction fight posterior collapse and improve value learning."}, {"id": "src_content_notes_world_models_hafner_dreamerv2", "label": "Mastering Atari with Discrete World Models (Hafner et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hafner et al.", "contributor": null}, {"id": "src_content_notes_world_models_dreamerv3", "label": "DreamerV3", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets one hyperparameter set across hundreds of domains: symlog transforms handle varying target scale without normalization, free bits keep the posterior from collapsing, and running-statistic-normalized heads enable cross-domain transfer."}, {"id": "src_content_notes_world_models_hafner_dreamerv3", "label": "DreamerV3: Mastering Diverse Domains through World Models (Hafner et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hafner et al.", "contributor": null}, {"id": "src_content_notes_world_models_genie", "label": "Google Genie", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learns an explicit latent action space from unannotated video via a video tokenizer plus causal dynamics model, so a single prompt image can instantiate a controllable interactive 2D world at inference."}, {"id": "src_content_notes_world_models_bruce_genie", "label": "Genie: Generative Interactive Environments (Bruce et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Bruce et al.", "contributor": null}, {"id": "src_content_notes_world_models_large_video_generation_models", "label": "High-Capacity Video Generation Models (GAIA-1, UniSim)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treated historically as media synthesis, but implicitly learn intuitive physics, object permanence and temporal causality from raw pixels."}, {"id": "src_content_notes_world_models_artificial_curiosity", "label": "Artificial Curiosity", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J\u00fcrgen Schmidhuber", "contributor": null, "rationale": "Rewards only learnable prediction errors, avoiding predictable noise and unpredictable chaos, which makes world model and exploration policy co-develop in a lifelong loop."}, {"id": "src_content_notes_world_models_schmidhuber_curiosity_1991", "label": "A Possibility for Implementing Curiosity and Boredom in Model-Building Neural Controllers (Schmidhuber)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J\u00fcrgen Schmidhuber", "contributor": null}, {"id": "src_content_notes_world_models_computational_creativity", "label": "Computational Principles of Creativity", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J\u00fcrgen Schmidhuber", "contributor": null, "rationale": "Beauty, fun and creativity are proportional to the compression progress a work induces in the observer's world model."}, {"id": "src_content_notes_world_models_schmidhuber_creativity_2012", "label": "Formal Theory of Creativity, Fun, and Intrinsic Motivation (Schmidhuber)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "J\u00fcrgen Schmidhuber", "contributor": null}, {"id": "src_content_notes_world_models_ha_schmidhuber_world_models_2018", "label": "World Models (Ha and Schmidhuber, 2018)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Ha and Schmidhuber", "contributor": null}, {"id": "src_content_notes_world_models_vae", "label": "VAE Vision Component (V)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compresses high-dimensional observations into a compact latent representation so all downstream prediction and control happens in latent space instead of pixels."}, {"id": "src_content_notes_world_models_controller", "label": "Controller (C)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_planning_in_latent_space", "label": "Planning in Latent Space", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolls candidate action sequences out in latent space to avoid expensive pixel-level simulation, then executes only the first action."}, {"id": "src_content_notes_world_models_latent_imagination", "label": "Latent Imagination", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_curl", "label": "CURL (Contrastive Unsupervised Representations)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses instance discrimination to shape the latent space without a generative decoder, avoiding the computational cost of reconstructing high-dimensional observations."}, {"id": "src_content_notes_world_models_laskin_curl", "label": "CURL: Contrastive Unsupervised Representations for Reinforcement Learning (Laskin et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Laskin et al.", "contributor": null}, {"id": "src_content_notes_world_models_iris", "label": "IRIS", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces recurrent memory with a GPT-style transformer over VQ-VAE tokens, gaining sample efficiency competitive with model-free methods while keeping discrete token capacity."}, {"id": "src_content_notes_world_models_micheli_iris", "label": "Transformers are Sample Efficient World Models (Micheli et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Micheli et al.", "contributor": null}, {"id": "src_content_notes_world_models_vq_vae", "label": "VQ-VAE", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_video_prediction_models", "label": "Video Prediction World Models (VideoGPT, Phenaki, CogVideo)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained with reconstruction plus KL-divergence objectives; the open difficulty is scaling to high-resolution long-horizon video while keeping temporal coherence."}, {"id": "src_content_notes_world_models_model_based_rl", "label": "Model-Based Reinforcement Learning", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The primary application: hallucinated rollouts raise sample efficiency by orders of magnitude and ensembles of world models supply uncertainty estimates for exploration."}, {"id": "src_content_notes_world_models_daydreamer", "label": "DayDreamer", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_wu_daydreamer", "label": "DayDreamer: World Models for Physical Robot Learning (Wu et al.)", "file_type": "paper", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Wu et al.", "contributor": null}, {"id": "src_content_notes_world_models_autonomous_driving", "label": "World Models for Autonomous Driving (Wayve)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learns a latent representation of road scenes from fleet data so driving policies can be evaluated closed-loop, because real-world testing is expensive and dangerous."}, {"id": "src_content_notes_world_models_evaluation_metrics", "label": "World Model Evaluation Metrics", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_compositionality", "label": "Compositionality (Open Problem)", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_long_horizon_prediction", "label": "Long-Horizon Prediction", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compounding error makes long rollouts degrade quadratically; proposed fixes are iterative refinement, sparse temporal attention and hierarchical timescale separation."}, {"id": "src_content_notes_world_models_grounding", "label": "Symbol Grounding Problem", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_world_models_causality", "label": "Causal World Models", "file_type": "concept", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinguishing intervention from observation is the step needed for genuine counterfactual 'what if?' reasoning, judged the most promising direction."}, {"id": "public_notes_world_models_figures_fig0", "label": "Side figure 0 (World Models)", "file_type": "image", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_world_models_figures_fig1", "label": "Figure 1 (World Models)", "file_type": "image", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_world_models_figures_fig2", "label": "Side figure 2 (World Models)", "file_type": "image", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_world_models_figures_fig3", "label": "Figure 3 (World Models)", "file_type": "image", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_world_models_figures_fig4", "label": "Figure 4 (World Models)", "file_type": "image", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_world_models_figures_fig5", "label": "Side figure 5 (World Models)", "file_type": "image", "source_file": "src/content/notes/world-models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "c