{"nodes": [{"id": "src_content_notes_intro_neural_networks", "label": "Introduction to Neural Networks", "file_type": "document", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_mathematical_model", "label": "Mathematical Model", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_learn_paradigm", "label": "The Learn Paradigm", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instead of a human writing rules, data and answers are supplied and the algorithm searches for the rules; this requires a hypothesis space, a loss function and an optimization algorithm."}, {"id": "src_content_notes_intro_neural_networks_inductive_bias", "label": "Inductive Bias", "file_type": "rationale", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No model can learn without assumptions: a small hypothesis space is easy to optimize but fails on complex relationships, while a vast one needs vast data to avoid mere memorization."}, {"id": "src_content_notes_intro_neural_networks_biological_neuron", "label": "Biological Neuron", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_action_potential", "label": "Action Potential (All-or-Nothing Firing)", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_hebbian_theory", "label": "Hebbian Theory / Synaptic Plasticity", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neurons that fire together, wire together: adaptive connection strengths in biology are the direct inspiration for learning by adjusting artificial weights."}, {"id": "src_content_notes_intro_neural_networks_artificial_neuron", "label": "Artificial Neuron (Perceptron)", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single neuron is an affine transformation plus a non-linearity; geometrically the weights define a hyperplane, so it can only represent linearly separable functions."}, {"id": "src_content_notes_intro_neural_networks_activation_functions", "label": "Activation Functions", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a nonlinearity, stacking layers collapses into a single linear transformation W2(W1 x) = W'x; activations bend and fold the space so complex decision boundaries become representable."}, {"id": "src_content_notes_intro_neural_networks_relu", "label": "ReLU", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_multilayer_perceptron", "label": "Multilayer Perceptron (MLP)", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layers are computed with matrix operations so all neurons of a layer are evaluated at once; stacking layers is what makes non-linearly-separable problems like XOR solvable."}, {"id": "src_content_notes_intro_neural_networks_neuron", "label": "Neuron class (NumPy)", "file_type": "code", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_layer", "label": "Layer class (NumPy)", "file_type": "code", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_mlp", "label": "MLP class (NumPy)", "file_type": "code", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_loss_function", "label": "Loss Function", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_mean_squared_error", "label": "Mean Squared Error", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Squaring keeps the error positive and penalizes large errors disproportionately, pushing the network to fix its worst mistakes first."}, {"id": "src_content_notes_intro_neural_networks_cross_entropy_loss", "label": "Cross-Entropy Loss", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Punishes a confident-but-wrong prediction exponentially, forcing the network to learn class boundaries quickly instead of settling on timid predictions."}, {"id": "src_content_notes_intro_neural_networks_softmax", "label": "Softmax", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_notes_intro_neural_networks_universal_approximation_theorem", "label": "Universal Approximation Theorem", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarantees an MLP with enough neurons can approximate any continuous function, but says nothing about how to find the parameters \u2014 capacity is not the same as trainability."}, {"id": "src_content_notes_intro_neural_networks_xor", "label": "XOR Problem", "file_type": "concept", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_intro_neural_networks_figures_fig_92eebecec7", "label": "The standard ML pipeline", "file_type": "image", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_notes_intro_neural_networks_figures_fig_742231c5af", "label": "Anatomy of a biological neuron", "file_type": "image", "source_file": "src/content/notes/intro-neural-networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pub