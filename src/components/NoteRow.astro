---
interface Props {
  title: string;
  topic: string;
  lang: string;
  slug: string;
  minutes?: number;
  shelf?: string;
  basePath?: string;
  summary?: string;
}

const { title, topic, lang, slug, minutes, shelf, basePath = '/notes', summary } = Astro.props;
---

<a
  href={`${basePath}/${slug}/`}
  data-topic={topic}
  data-shelf={shelf}
  data-lang={lang.toUpperCase()}
  class="group grid grid-cols-[1fr_auto] items-start gap-4 py-5 transition-colors sm:gap-6"
>
  <span class="min-w-0">
    <span class="font-display text-ink group-hover:text-signal-ink block text-xl leading-snug text-pretty transition-colors">
      {title}
    </span>
    {summary && (
      <span class="text-ink-soft mt-1 block text-sm leading-relaxed line-clamp-2">{summary}</span>
    )}
    {/* Keyword line stays visible (smaller) so topics remain scannable/searchable. */}
    <span class="text-ink-muted mt-1 block text-xs">
      {topic} · {lang}{typeof minutes === 'number' ? ` · ${minutes} min` : ''}
    </span>
  </span>

  <span class="flex items-center pt-1">
    <span
      aria-hidden="true"
      class="text-ink-muted transition-[transform,color] duration-150 ease-out motion-safe:pointer-fine:group-hover:translate-x-0.5 group-hover:text-signal-ink"
    >
      →
    </span>
  </span>
</a>