---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  showYear?: boolean;
}

const { entry, showYear = true } = Astro.props;
const { title, summary, date, category, featured } = entry.data;

const year = date.getUTCFullYear();
---

<a
  href={`/${entry.id}`}
  data-category={category ?? ''}
  class="group grid grid-cols-[1fr_auto] items-start gap-5 py-6 transition-colors sm:gap-6"
>
  <span class="min-w-0">
    <span class="text-ink-muted block text-sm">
      {featured ? 'Featured · ' : ''}{showYear ? `${year}${category ? ' · ' : ''}` : ''}{category ?? ''}
    </span>
    <span class="font-display text-ink group-hover:text-signal-ink mt-1.5 block text-xl leading-snug text-pretty transition-colors sm:text-2xl">
      {title}
    </span>
    <span class="text-ink-soft mt-1.5 block text-sm leading-relaxed line-clamp-2">{summary}</span>
  </span>

  <span class="flex items-center pt-1">
    <span
      aria-hidden="true"
      class="text-ink-muted transition-[transform,color] duration-150 ease-out motion-safe:pointer-fine:group-hover:translate-x-0.5 group-hover:text-signal-ink"
    >
      →
    </span>
  </span>
</a>
