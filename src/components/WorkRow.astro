---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, date, category, featured } = entry.data;

const year = date.getUTCFullYear();
const poster = entry.data.hero ?? `/images/projects/${entry.id}.jpg`;
---

<a
  href={`/${entry.id}`}
  data-category={category ?? ''}
  class="group grid grid-cols-[3.5rem_1fr_auto] items-start gap-5 py-6 transition-colors sm:grid-cols-[5rem_1fr_auto] sm:gap-6"
>
  <img
    src={poster}
    alt=""
    aria-hidden="true"
    loading="lazy"
    width="960"
    height="1200"
    class="aspect-[4/5] w-14 shrink-0 rounded-[6px] border border-line object-cover sm:w-20 mt-0.5"
  />

  <span class="min-w-0">
    <span class="text-ink-muted block text-sm">
      {featured ? `Featured · ${year}` : year}{category ? ` · ${category}` : ''}
    </span>
    <span class="font-display text-ink group-hover:text-signal-ink mt-1.5 block text-xl leading-snug text-pretty transition-colors sm:text-2xl">
      {title}
    </span>
    <span class="text-ink-soft mt-1.5 block text-sm leading-relaxed line-clamp-2">{summary}</span>
  </span>

  <span class="flex items-center pt-1">
    <span
      aria-hidden="true"
      class="text-ink-muted transition-[transform,color] duration-150 ease-out motion-safe:pointer-fine:group-hover:translate-x-0.5 group-hover:text-signal-ink"
    >
      →
    </span>
  </span>
</a>
