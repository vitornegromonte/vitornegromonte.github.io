---
import { SITE } from '@/site.config';

const year = new Date().getFullYear();
---

<footer>
  <div
    class="text-ink-soft mx-auto flex max-w-3xl flex-col gap-4 px-6 py-10 text-sm sm:flex-row sm:items-start sm:justify-between"
  >
    <p>
      © {year} {SITE.name}.<br />Built with Astro.
    </p>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="Contact and social links">
      <a href={`mailto:${SITE.email}`} class="inline-flex min-h-11 items-center hover:text-signal-ink transition-colors">
        Email
      </a>
      {
        SITE.social.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center hover:text-signal-ink transition-colors" rel="me">
            {link.label}
          </a>
        ))
      }
      <a href="/cv.pdf" download class="inline-flex min-h-11 items-center hover:text-signal-ink transition-colors">
        Curriculum
      </a>
      <a href="#top" class="inline-flex min-h-11 items-center hover:text-signal-ink transition-colors"> Top ↑ </a>
    </nav>
  </div>
</footer>
