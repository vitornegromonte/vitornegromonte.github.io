---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { entry } = Astro.props;
const { title, year, venue, venueDetails, pdfUrl, codeUrl, summary } = entry.data;
const isAward = /award|best|honorable|prize|distinction/i.test(venueDetails ?? '');
---

<div class="border-line group grid grid-cols-1 items-start gap-1 border-b py-6 sm:grid-cols-[4rem_1fr_auto] sm:gap-6">
  <span class="text-ink-soft font-mono text-[11px] tracking-[0.08em] uppercase">{year}</span>

  <span class="min-w-0">
    <span class="font-display text-ink block text-lg leading-snug text-pretty transition-colors">{title}</span>
    <span class="text-ink-soft mt-1 block text-sm leading-relaxed italic">
      {venue}
      {venueDetails && ` — ${venueDetails}`}
      {isAward && <span class="text-signal not-italic" title="Award"> ★</span>}
    </span>
    {summary && <span class="text-ink-soft mt-1 block text-sm italic leading-relaxed">{summary}</span>}
  </span>

  <span class="flex items-center gap-4">
    <span class="flex gap-3 font-mono text-[11px] tracking-[0.08em] uppercase">
      {pdfUrl && <a href={pdfUrl.toString()} class="text-ink-soft hover:text-signal transition-colors hover:underline hover:underline-offset-4">PDF</a>}
      {codeUrl && codeUrl.toString() !== '#' && (
        <a href={codeUrl.toString()} class="text-ink-soft hover:text-signal transition-colors hover:underline hover:underline-offset-4">Code</a>
      )}
    </span>
  </span>
</div>
