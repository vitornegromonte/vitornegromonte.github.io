---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'>;
  showYear?: boolean;
}

const { entry, showYear = true } = Astro.props;
const { title, year, venue, venueDetails, pdfUrl, codeUrl, summary } = entry.data;
const isAward = /award|best|honorable|prize|distinction/i.test(venueDetails ?? '');
---

<div
  class:list={[
    'group grid grid-cols-1 items-start gap-1 py-5 sm:gap-6',
    showYear ? 'sm:grid-cols-[4rem_1fr_auto]' : 'sm:grid-cols-[1fr_auto]',
  ]}
>
  {showYear && <span class="text-ink-muted text-sm tabular-nums">{year}</span>}

  <span class="min-w-0">
    <span class="font-display text-ink block text-lg leading-snug text-pretty transition-colors">{title}</span>
    <span class="text-ink-soft mt-1 block text-sm leading-relaxed">
      {venue}{venueDetails && ` — ${venueDetails}`}
      {isAward && <span class="text-ink-muted"> · Award</span>}
    </span>
    {summary && <span class="text-ink-soft mt-1 block text-sm leading-relaxed">{summary}</span>}
  </span>

  <span class="flex items-center gap-4">
    <span class="flex gap-3 text-sm">
      {pdfUrl && <a href={pdfUrl.toString()} class="text-ink-soft inline-flex min-h-11 items-center transition-colors hover:text-signal-ink hover:underline hover:underline-offset-4">PDF</a>}
      {codeUrl && codeUrl.toString() !== '#' && (
        <a href={codeUrl.toString()} class="text-ink-soft inline-flex min-h-11 items-center transition-colors hover:text-signal-ink hover:underline hover:underline-offset-4">Code</a>
      )}
    </span>
  </span>
</div>
