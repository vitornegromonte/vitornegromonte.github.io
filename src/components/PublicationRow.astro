---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { entry } = Astro.props;
const { title, year, venue, venueDetails, pdfUrl, codeUrl, summary } = entry.data;
const isAward = /award|best|honorable|prize|distinction/i.test(venueDetails ?? '');
---

<div class="group grid grid-cols-1 items-start gap-1 py-5 sm:grid-cols-[4rem_1fr_auto] sm:gap-6">
  <span class="text-ink-muted text-sm tabular-nums">{year}</span>

  <span class="min-w-0">
    <span class="font-display text-ink block text-lg leading-snug text-pretty transition-colors">{title}</span>
    <span class="text-ink-soft mt-1 block text-sm leading-relaxed">
      {venue}{venueDetails && ` — ${venueDetails}`}
      {isAward && <span class="text-ink-muted"> · Award</span>}
    </span>
    {summary && <span class="text-ink-soft mt-1 block text-sm leading-relaxed">{summary}</span>}
  </span>

  <span class="flex items-center gap-4">
    <span class="flex gap-3 text-sm">
      {pdfUrl && <a href={pdfUrl.toString()} class="text-ink-soft hover:text-signal-ink transition-colors hover:underline hover:underline-offset-4">PDF</a>}
      {codeUrl && codeUrl.toString() !== '#' && (
        <a href={codeUrl.toString()} class="text-ink-soft hover:text-signal-ink transition-colors hover:underline hover:underline-offset-4">Code</a>
      )}
    </span>
  </span>
</div>
