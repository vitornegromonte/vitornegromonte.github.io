---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteRow from '@/components/NoteRow.astro';

const notes = (await getCollection('notes')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
// Topic-based shelves (renamed from Handbook/Others). Map new notes here.
const SHELF_BY_ID: Record<string, string> = {
  'intro-neural-networks': 'Foundations',
  autodiff: 'Foundations',
  generalization: 'Foundations',
  'generative-images': 'Generative Models',
  'world-models': 'World Models',
};
const shelves = [...new Set(Object.values(SHELF_BY_ID))];
const languages = [...new Set(notes.map((note) => note.data.lang.toUpperCase()))].sort();
const languageName = (language: string) =>
  ({ EN: 'English', PT: 'Português' })[language] ?? language;
function minutesOf(body: string | undefined): number {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}
const notesWithTime = notes.map((note) => ({
  note,
  minutes: minutesOf(note.body),
  shelf: SHELF_BY_ID[note.id] ?? 'Other',
}));
---

<BaseLayout
  title="Field Notes"
  description="Machine learning study notes by Vitor Negromonte."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <h1 class="font-display text-ink text-4xl leading-[1.08] font-normal text-balance sm:text-5xl">Field Notes</h1>
    <p class="text-ink-soft mb-8 max-w-xl text-base leading-relaxed">
      Study notes from the desk — deep learning, in Portuguese and English.
    </p>

    <div class="mb-8 flex flex-wrap items-center gap-3">
      <span class="text-ink-muted text-sm">Filter</span>
      <div class="relative">
        <label for="note-shelf" class="sr-only">Filter by shelf</label>
        <select
          id="note-shelf"
          data-note-shelf
          class="border-line text-ink bg-surface hover:border-signal focus:border-signal-ink h-11 w-[11.5rem] cursor-pointer appearance-none rounded-lg border py-0 pr-10 pl-3.5 text-sm outline-none transition-[border-color,background-color] focus:ring-2 focus:ring-signal-ink/15"
        >
          <option value="all">All shelves</option>
          {shelves.map((shelf) => (
            <option value={shelf}>{shelf}</option>
          ))}
        </select>
        <svg
          class="text-ink-soft pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="relative">
        <label for="note-language" class="sr-only">Filter by language</label>
        <select
          id="note-language"
          data-note-language
          class="border-line text-ink bg-surface hover:border-signal focus:border-signal-ink h-11 w-[11.5rem] cursor-pointer appearance-none rounded-lg border py-0 pr-10 pl-3.5 text-sm outline-none transition-[border-color,background-color] focus:ring-2 focus:ring-signal-ink/15"
        >
          <option value="all">All languages</option>
          {languages.map((language) => (
            <option value={language}>{languageName(language)}</option>
          ))}
        </select>
        <svg
          class="text-ink-soft pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <div>
      {notesWithTime.map(({ note, minutes, shelf }) => (
        <NoteRow {...note.data} slug={note.id} minutes={minutes} shelf={shelf} />
      ))}
      <p data-empty hidden class="text-ink-soft mt-8 text-sm leading-relaxed">
        No notes match these filters.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const shelfSelect = document.querySelector<HTMLSelectElement>('[data-note-shelf]');
  const languageSelect = document.querySelector<HTMLSelectElement>('[data-note-language]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-shelf]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  function apply() {
    const shelf = shelfSelect?.value ?? 'all';
    const language = languageSelect?.value ?? 'all';
    let visible = 0;
    for (const row of rows) {
      const hidden =
        (shelf !== 'all' && row.dataset.shelf !== shelf) ||
        (language !== 'all' && row.dataset.lang !== language);
      row.hidden = hidden;
      if (!hidden) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  }

  shelfSelect?.addEventListener('change', apply);
  languageSelect?.addEventListener('change', apply);
</script>