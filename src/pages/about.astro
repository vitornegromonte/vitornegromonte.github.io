---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';
import { experience, education, teaching, awards, extracurricular, skills } from '@/utils/cv.mjs';

const aboutEntries = await getCollection('about');
const about = aboutEntries[0];
if (!about) throw new Error('Missing src/content/about/index.md');
const { Content } = await render(about);
const { role, interests, tools } = about.data;
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <h1 class="font-display text-ink max-w-xl text-3xl font-medium leading-[1.08] text-balance sm:text-4xl">
      {role}
    </h1>

    <div class="prose mt-8 max-w-none">
      <Content />
    </div>

    <div class="mt-10">
      <h2 class="text-ink mb-2 text-base font-semibold">Now</h2>
      <p class="text-ink-soft text-sm leading-relaxed">
        Software Engineer (ML) Fellow at Sinapse, president of Ligia UFPE, and drafting an open
        deep learning handbook in the <a href="/notes" class="text-signal-ink hover:underline">Field Notes</a>.
      </p>
    </div>

    <div class="mt-10">
      <h2 class="text-ink mb-2 text-base font-semibold">Research interests</h2>
      <p class="text-ink-soft text-sm leading-relaxed">{interests.join(', ')}</p>
    </div>

    <div class="mt-8">
      <h2 class="text-ink mb-2 text-base font-semibold">Tools</h2>
      <p class="text-ink-soft text-sm leading-relaxed">{tools.join(', ')}</p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/cv">Full CV →</Button>
      <Button href={`mailto:${SITE.email}`} variant="ghost">Get in touch</Button>
    </div>

    <div class="mt-20">
      <SectionHeading eyebrow="Experience" />
      <div>
        {experience.map((item) => (
          <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-ink-muted text-sm">{item.period}</span>
            <span>
              <span class="text-ink block text-sm font-medium">{item.role}</span>
              <span class="text-ink-soft block text-sm">{item.institution}</span>
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Education" />
      <div>
        {education.map((item) => (
          <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-ink-muted text-sm">{item.period}</span>
            <span>
              <span class="text-ink block text-sm font-medium">{item.degree}</span>
              <span class="text-ink-soft block text-sm">{item.institution}</span>
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Teaching" />
      <div>
        {teaching.map((item) => (
          <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-ink-muted text-sm">{item.institution}</span>
            <span>
              <span class="text-ink block text-sm font-medium">{item.course}</span>
              {item.roles.map((r) => (
                <span class="text-ink-soft block text-sm">{r.role} ({r.period})</span>
              ))}
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Awards" />
      <div>
        {awards.map((item) => (
          <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-ink-muted text-sm">{item.year}</span>
            <span>
              <span class="text-ink block text-sm font-medium">{item.title}</span>
              <span class="text-ink-soft block text-sm">{item.venue}</span>
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Extracurricular" />
      <div>
        {extracurricular.map((item) => (
          <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-ink-muted text-sm">{item.role}</span>
            <span>
              <span class="text-ink block text-sm font-medium">{item.activity}</span>
              <span class="text-ink-soft block text-sm">{item.description}</span>
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Skills" />
      <div>
        {skills.map(([category, list]) => (
          <div class="grid grid-cols-1 gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-ink-muted text-sm">{category}</span>
            <span class="text-ink block text-sm">{list}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>