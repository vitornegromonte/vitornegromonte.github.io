---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-6 py-32">
    <p class="text-ink-soft font-mono text-xs tracking-[0.18em] uppercase">404 — Not found</p>
    <h1 class="font-display text-ink text-3xl font-medium tracking-[-0.015em] leading-[1.08] text-balance">That page wandered off.</h1>
    <p class="text-ink-soft max-w-md leading-relaxed">The link may be broken, or the page may have moved. You are still in the right place.</p>
    <a href="/" class="text-signal font-mono text-sm hover:underline hover:underline-offset-4">← Back home</a>
  </section>
</BaseLayout>
