---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import PublicationRow from '@/components/PublicationRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import NoteRow from '@/components/NoteRow.astro';
import { SITE } from '@/site.config';

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = allWork.filter((entry) => entry.data.featured);
const rest = allWork.filter((entry) => !entry.data.featured);
// The field-notes repo lives on /projects; the homepage links to /notes instead.
const selected = [...featured, ...rest].filter((entry) => entry.id !== 'field-notes').slice(0, 3);

const publications = (await getCollection('publications')).sort((a, b) =>
  b.data.year.localeCompare(a.data.year),
);
const topPublications = publications.slice(0, 3);

const notes = (await getCollection('notes')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const topNotes = notes.slice(0, 3);

const [leadWork, ...moreWork] = selected;
const leadYear = leadWork?.data.date.getUTCFullYear();
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.08] text-balance sm:text-5xl">
      Vitor Negromonte
    </h1>

    <p class="text-ink-soft mt-6 max-w-xl text-xl leading-relaxed">
      {SITE.description}
    </p>

    <p class="text-ink-muted mt-3 text-sm">{SITE.openTo}</p>

    <p class="text-ink-muted mt-1 text-sm">{SITE.status}</p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/projects" variant="solid">Browse the projects →</Button>
      <Button href="/notes" variant="ghost">Read the field notes</Button>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Selected work" />
    {leadWork && (
      <a href={`/${leadWork.id}`} class="group mb-4 flex flex-col transition-colors">
        <span class="min-w-0">
          <span class="text-ink-muted block text-sm">
            {leadWork.data.featured ? 'Featured · ' : ''}{leadYear}{leadWork.data.category ? ` · ${leadWork.data.category}` : ''}
          </span>
          <span class="font-display text-ink group-hover:text-signal-ink mt-2 block text-2xl leading-tight text-balance transition-colors">
            {leadWork.data.title}
          </span>
          <span class="text-ink-soft mt-2 block text-sm leading-relaxed line-clamp-3">{leadWork.data.summary}</span>
          <span class="text-signal-ink mt-3 inline-block text-sm group-hover:underline group-hover:underline-offset-4">
            Open project →
          </span>
        </span>
      </a>
    )}
    <div>
      {moreWork.map((entry) => <WorkRow entry={entry} />)}
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
      <a
        href="/projects"
        class="text-ink-soft inline-flex min-h-11 items-center text-sm transition-colors hover:text-signal-ink"
      >
        View all projects →
      </a>
      <a
        href="/notes"
        class="text-signal-ink inline-flex min-h-11 items-center text-sm hover:underline hover:underline-offset-4"
      >
        Read the field notes →
      </a>
    </div>
  </section>

  <section id="publications" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Publications" />
    <div>
      {topPublications.map((entry) => <PublicationRow entry={entry} />)}
    </div>
    <div class="mt-6">
      <a
        href="/publications"
        class="text-ink-soft inline-flex min-h-11 items-center text-sm transition-colors hover:text-signal-ink"
      >
        All publications →
      </a>
    </div>
  </section>

  <section id="notes" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Notes" />
    <div>
      {topNotes.map((note) => (
        <NoteRow {...note.data} slug={note.id} />
      ))}
    </div>
    <div class="mt-6">
      <a
        href="/notes"
        class="text-ink-soft inline-flex min-h-11 items-center text-sm transition-colors hover:text-signal-ink"
      >
        All notes →
      </a>
    </div>
  </section>

  <section id="about" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="About" />
    <p class="text-ink-soft max-w-xl leading-relaxed">
      Building some cool things with reasoning, efficient AI and mech interp.
    </p>
    <a href="/about" class="text-signal-ink mt-4 inline-flex min-h-11 items-center text-sm hover:underline hover:underline-offset-4">
      More about me →
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Correspondence" />
    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Get in touch
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="text-signal-ink mt-4 inline-flex min-h-11 items-center gap-2 hover:underline"
    >
      {SITE.email}
    </a>
  </section>
</BaseLayout>